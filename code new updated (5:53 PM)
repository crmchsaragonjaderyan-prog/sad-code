  };

  const distanceKm = (lat1: number, lng1: number, lat2: number, lng2: number) => {
    const toRad = (v: number) => (v * Math.PI) / 180;
    const R = 6371;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  };

  const notifyNearbyUsers = async (report: { lat: number; lng: number; type: string; name: string }, radiusKm = 5) => {
    if (!db) return;
    try {
      const usersSnap = await getDocs(collection(db, 'users'));
      const jobs: Promise<void>[] = [];
      usersSnap.docs.forEach(userDoc => {
        const u = userDoc.data();
        const uid = u.uid;
        const lat = Number(u.lat);
        const lng = Number(u.lng);
        if (!uid || uid === currentUserUid || !Number.isFinite(lat) || !Number.isFinite(lng)) return;
        if (distanceKm(report.lat, report.lng, lat, lng) <= radiusKm) {
          jobs.push(addNotification(
            report.type === 'LOST' ? '📍 Lost Pet Near You' : '🐾 Found Pet Near You',
            `${report.name} was reported ${report.type.toLowerCase()} within about ${radiusKm} km of your saved location. Check the Cases/Map tab.`,
            'PROXIMITY', uid
          ));
        }
      });
      await Promise.all(jobs);
    } catch (err) {
      console.log('⚠️ Nearby notification check failed:', err instanceof Error ? err.message : String(err));
    }
  };

  const notifyPotentialLostOwners = async (newReport: any) => {
    if (!db || newReport.type !== 'FOUND') return;
    try {
      const lostReports = reports.filter(r => r.type === 'LOST' && r.status === 'Active' && r.ownerUid);
      const jobs: Promise<void>[] = [];
      lostReports.forEach(lost => {
        let score = 50;
        const lostSpecies = (lost.species || '').trim().toLowerCase();
        const foundSpecies = (newReport.species || '').trim().toLowerCase();
        const lostBreed = (lost.breed || '').trim().toLowerCase();
        const foundBreed = (newReport.breed || '').trim().toLowerCase();
        const lostCoat = (lost.coatPattern || '').trim().toLowerCase();
        const foundCoat = (newReport.coatPattern || '').trim().toLowerCase();
        const unknownBreed = (value: string) => !value || value.includes('unknown') || value.includes('mixed breed') || value === 'none' || value === 'n/a';

        if (lostSpecies && foundSpecies && lostSpecies === foundSpecies) score += 20;
        if (!unknownBreed(lostBreed) && !unknownBreed(foundBreed) && (lostBreed.includes(foundBreed) || foundBreed.includes(lostBreed))) score += 15;
        if (lost.markings && newReport.markings && lost.markings.toLowerCase() !== 'none' && newReport.markings.toLowerCase().includes(lost.markings.toLowerCase())) score += 10;
        if (!unknownBreed(lostCoat) && !unknownBreed(foundCoat) && (lostCoat.includes(foundCoat) || foundCoat.includes(lostCoat))) score += 5;
        if (distanceKm(lost.lat, lost.lng, newReport.lat, newReport.lng) <= 5) score += 5;
        score = Math.min(100, score);
        if (score >= 75 && lost.ownerUid) {
          jobs.push(addNotification(
            '🔎 Possible Match for Your Lost Pet',
            `A found report for ${newReport.name} may match your lost pet ${lost.name} (${score}% match). Review the case in FurEver Found.`,
            'MATCH', lost.ownerUid, newReport.id
          ));
        }
      });
      await Promise.all(jobs);
    } catch (err) {
