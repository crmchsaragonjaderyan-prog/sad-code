  const handleCredentialLogin = async () => {
    if (!authEmail || !authPassword) {
      Alert.alert('Error', 'Please enter both Email and Password.');
      return;
    }
    if (!auth || !db) {
      Alert.alert('❌ Error', 'Firebase not connected. Check firebase.ts');
      return;
    }

    try {
      const email = authEmail.trim().toLowerCase();
      const userCred = await signInWithEmailAndPassword(auth, email, authPassword);
      const user = userCred.user;

      // Always read the actual role stored in Firestore.
      const usersRef = collection(db, 'users');
      const q = query(usersRef, where('email', '==', email));
      const snap = await getDocs(q);

      if (snap.empty) {
        Alert.alert('❌ Login Failed', 'No account profile found.');
        await signOut(auth);
        return;
      }

      const userDoc = snap.docs[0].data();
      const userDocRef = snap.docs[0].ref;
      const actualRole = userDoc.role || '';

      if (userDoc.active === false) {
        Alert.alert('🚫 Account Deactivated', 'This account has been deactivated by an administrator. Please contact support.');
        await signOut(auth);
        return;
      }

      // Admin accounts are private/pre-created, so they do not need the public
      // Gmail verification step. Pet Owner and Community Member accounts do.
      if (actualRole !== 'ADMINISTRATOR') {
        await reload(user);
        if (!user.emailVerified) {
          Alert.alert(
            '📬 Email Not Verified',
            'Please check your Gmail and click the verification link first.',
            [
              {
                text: 'Resend Email',
                onPress: async () => {
                  try {
                    await sendEmailVerification(user);
                    Alert.alert('✅ Resent!', 'Verification email sent again.');
                  } catch (resendError) {
                    Alert.alert(
                      '❌ Resend Failed',
                      resendError instanceof Error ? resendError.message : 'Could not resend verification email.'
                    );
                  }
                }
              },
              { text: 'OK' }
            ]
          );
          await signOut(auth);
          return;
        }
      }

      await saveLoginRecord(email, actualRole);
      setCurrentUserUid(user.uid);
      setCurrentRole(actualRole);
      setActiveTab(actualRole === 'ADMINISTRATOR' ? 'admin' : 'map');
      setAdminSubTab('dashboard');
      setAuthEmail('');
      setAuthPassword('');

      // Keep the Firestore profile in sync for verified public accounts.
      if (actualRole !== 'ADMINISTRATOR') {
        await updateDoc(userDocRef, { emailVerified: true });
      }

      Alert.alert(
        actualRole === 'ADMINISTRATOR' ? '🔐 Admin Login Successful' : '✅ Verified & Logged In',
        `Welcome! Signed in as ${actualRole}`
      );
    } catch (err: any) {
      Alert.alert('❌ Login Error', err instanceof Error ? err.message : 'Unknown error');
    }
  };

